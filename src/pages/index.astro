---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PrimaryCTA from "../components/PrimaryCTA.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { testimonials } from "../data/testimonials";
import { founder } from "../data/founder";

const heroChecks = [
	"Replace Agency Chaos With Leadership",
	"Align Marketing To Revenue Goals",
	"Reduce Waste With Smarter Systems And AI",
];

const benefits = [
	{
		title: "You start in the right place, not the expensive place.",
		description:
			"Most AI money gets burned on the wrong problem. I read your whole business first, then point AI at the one or two spots where it actually moves profit. No science projects.",
	},
	{
		title: "You get an operator, not an advisor who disappears.",
		description:
			"I've run twelve companies. I don't hand you a slide deck and leave. I sit on your side of the table, put the tools to work, and stay until they're earning their keep.",
	},
	{
		title: "You get judgment across the whole business, not just one corner.",
		description:
			"Finance, operations, marketing, sales, HR, manufacturing. I've owned every square on the board. That's why I can tell what AI should touch, what it shouldn't, and prove the return either way.",
	},
];

const features = [
	["Fractional CMO Leadership", "Marketing Strategy And Roadmap", "Brand And Messaging Alignment", "Agency And Vendor Oversight", "KPI Definition And Reporting"],
	["Funnel And Conversion Review", "CRM And Marketing System Optimization", "AI And Automation Opportunity Mapping", "Weekly Or Biweekly Leadership Cadence"],
];

const faqs = [
	{
		question: "How is this different from hiring a full-time Director of Marketing or CMO?",
		answer:
			"You get senior-level leadership without salary, benefits, onboarding time, or long-term risk. You gain experience and perspective immediately, with flexibility to scale up or down as your business needs change.",
	},
	{
		question: "Who is this for?",
		answer:
			"Established businesses that want growth, clarity, and accountability. Typical clients we work with generate $5M+ in revenue.",
	},
	{
		question: "Is this the same as hiring an agency?",
		answer: "No. Agencies execute tasks. I own the strategy and hold execution accountable.",
	},
	{
		question: "Is this more like a CMO or a marketing manager?",
		answer: "It is senior leadership focused on results. Strategy plus execution ownership, without full-time overhead.",
	},
	{
		question: "How long do clients typically work with you?",
		answer: "Most engagements start at six months and continue as long as growth and clarity are priorities.",
	},
	{
		question: "Will you do the work or just advise?",
		answer: "I lead, guide, and step in where needed. The goal is progress, not busywork.",
	},
	{
		question: "Is AI actually practical for my business?",
		answer: "Yes, when applied correctly. I focus on real automation that saves time and money, not hype.",
	},
];

const structuredData = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	name: "SumoLab",
	description: "SumoLab provides fractional CMO leadership for established businesses generating $5M+ in annual revenue.",
	url: "https://sumolab.co",
	areaServed: "US",
};
---

<Layout
	title="SumoLab | Fractional CMO Driving Business Growth"
	description="Fractional CMO for established businesses that need clear strategy, accountable execution, and modern automation without hiring full time."
	structuredData={structuredData}
	transparentHeader
>
	<main>
		<!-- Hero -->
		<section class="relative isolate overflow-hidden">
			<img
				src="/photos/hero-entrepreneur-office-v3.jpg"
				alt=""
				width="1920"
				height="1080"
				class="absolute inset-0 h-full w-full object-cover object-[80%_center]"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-brand-ink via-brand-ink/75 to-brand-ink/40" aria-hidden="true"
			></div>
			<div
				class="relative mx-auto flex min-h-[88vh] max-w-(--container-content) flex-col justify-end px-6 pt-24 pb-16 md:px-10 md:pb-20 lg:px-12"
			>
				<span class="mb-6 block h-1 w-16 bg-brand-citrus" aria-hidden="true"></span>
				<h1 class="text-statement text-mega leading-[0.95] text-brand-offwhite">
					AI won't fix<br />your business.
				</h1>
				<div class="mt-8 flex max-w-xl flex-col gap-6">
					<p class="text-xl font-semibold leading-snug text-brand-offwhite md:text-2xl">
						Understanding your business will&hellip; <br />and I've spent a lifetime learning both.
					</p>
					<ul class="flex flex-col gap-3">
						{
							heroChecks.map((item) => (
								<li class="flex items-start gap-3">
									<svg
										class="mt-0.5 h-5 w-5 shrink-0 text-brand-citrus"
										viewBox="0 0 20 20"
										fill="none"
										aria-hidden="true"
									>
										<circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5" />
										<path
											d="M6 10.5l2.5 2.5L14 7.5"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									<span class="text-supporting text-brand-offwhite">{item}</span>
								</li>
							))
						}
					</ul>
					<div>
						<PrimaryCTA tone="citrus" ring="citrus" />
					</div>
				</div>
			</div>
		</section>

		<!-- Problem / Solution (PAS) -->
		<Section tone="white">
			<Eyebrow>The gap</Eyebrow>
			<h2 class="text-statement mt-4 max-w-4xl text-huge leading-[1.05] text-brand-ink">
				You were told AI would change everything. So far it's just changed your budget.
			</h2>
			<div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
				<div class="lg:col-span-7">
					<p class="text-supporting text-lg text-brand-ink">
						You bought the tools. Sent the team to the webinars. Maybe even hired a consultant. And you
						still can't answer the only question that matters: did any of it make us money? Is our
						marketing generating more leads?
					</p>
					<p class="text-supporting mt-4 text-lg text-brand-ink">
						You're not alone. MIT found 95% of corporate AI projects return nothing. Not because the tech
						is broken, but because it gets aimed at the wrong problem by people who don't understand the
						business underneath it. Meanwhile the clock runs, competitors inch ahead, and "AI" quietly
						becomes a line item you'd rather not explain.
					</p>
				</div>
				<div class="lg:col-span-5">
					<div class="bg-brand-purple p-8 text-brand-white">
						<p class="text-label text-brand-citrus">Solution</p>
						<p class="text-statement mt-3 text-2xl">That's the gap I close.</p>
						<p class="text-supporting mt-4 text-brand-white/85">
							I'm not a technologist selling software. I'm an operator who's built and run twelve
							companies across every department there is, and went deep on AI the day it arrived. I
							start with your business, find the one or two places AI actually moves profit, and prove
							the return. No science projects. No hype. You stop guessing at AI and start getting paid
							by it.
						</p>
					</div>
				</div>
			</div>
		</Section>

		<!-- Benefits -->
		<Section tone="offwhite">
			<Eyebrow>Benefits</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-huge text-brand-ink">
				So, what are the benefits?
			</h2>
			<div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-3">
				{
					benefits.map((benefit) => (
						<div class="border-t-2 border-brand-purple pt-5">
							<h3 class="text-statement text-2xl text-brand-ink">{benefit.title}</h3>
							<p class="text-supporting mt-3 text-brand-neutral">{benefit.description}</p>
						</div>
					))
				}
			</div>
		</Section>

		<!-- Full-bleed image band -->
		<section class="relative isolate flex min-h-[60vh] items-end overflow-hidden">
			<img src="/photos/team-diverse-office-2.jpg" alt="" class="absolute inset-0 h-full w-full object-cover" />
			<div class="absolute inset-0 bg-gradient-to-t from-brand-ink/85 via-brand-ink/20 to-transparent" aria-hidden="true"
			></div>
			<div class="relative mx-auto w-full max-w-(--container-content) px-6 pb-14 md:px-10 lg:px-12">
				<p class="text-statement max-w-2xl text-huge text-brand-offwhite">
					Senior leadership, not another vendor. One person who owns the outcome.
				</p>
			</div>
		</section>

		<!-- Testimonials -->
		<Section tone="ink">
			<Eyebrow tone="citrus">What clients say</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-huge text-brand-offwhite">
				Don't take our word for it.
			</h2>
			<div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2">
				{
					testimonials.map((t) => (
						<div class="border border-brand-offwhite/15 p-8">
							<div class="flex items-center gap-4">
								<img
									src={t.photoSrc}
									alt={t.name}
									width="56"
									height="56"
									class="h-14 w-14 rounded-full object-cover"
								/>
								<div>
									<p class="text-supporting font-semibold text-brand-offwhite">{t.name}</p>
									<p class="text-legal text-brand-offwhite/60">{t.title}</p>
								</div>
							</div>
							<div class="mt-4 flex gap-1 text-brand-citrus" aria-hidden="true">
								{"★★★★★"}
							</div>
							<p class="text-supporting mt-4 text-brand-offwhite/90">&ldquo;{t.quote}&rdquo;</p>
						</div>
					))
				}
			</div>
		</Section>

		<!-- About / Founder -->
		<section class="relative bg-brand-white text-brand-ink">
			<div class="mx-auto max-w-(--container-content) px-6 pt-20 pb-20 md:px-10 md:pt-28 md:pb-28 lg:px-12 lg:pb-0">
				<div class="relative grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
					<div class="lg:col-span-5">
						<img
							src={founder.headshotSrc ?? undefined}
							alt={founder.name ?? "Founder"}
							width="662"
							height="662"
							class="w-full max-w-sm lg:absolute lg:bottom-0 lg:left-0 lg:z-10 lg:w-[28rem] lg:max-w-none"
						/>
					</div>
					<div class="flex flex-col justify-center lg:col-span-7 lg:pb-24">
						<Eyebrow>About</Eyebrow>
						<h2 class="text-statement mt-4 text-huge text-brand-ink">
							Hi, I'm {founder.name}.
						</h2>
						<p class="text-supporting mt-6 max-w-xl text-lg text-brand-neutral">{founder.bio}</p>
						<a
							href="/about"
							class="text-button group mt-6 inline-flex items-center gap-2 self-start text-brand-purple focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-purple"
						>
							<span>About Jerry</span>
							<span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-0.5"
								>&rarr;</span
							>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Features -->
		<Section tone="offwhite">
			<Eyebrow>Features</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-huge text-brand-ink">We feature.</h2>
			<p class="text-supporting mt-4 text-brand-neutral">Simple. Logical.</p>
			<div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-4 sm:grid-cols-2">
				{
					features.map((column) => (
						<ul class="flex flex-col gap-4">
							{column.map((item) => (
								<li class="flex items-start gap-3 border-b border-brand-neutral-soft pb-4">
									<svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-purple" viewBox="0 0 20 20" fill="none" aria-hidden="true">
										<path
											d="M4 10.5l3.5 3.5L16 5.5"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									<span class="text-supporting text-brand-ink">{item}</span>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</Section>

		<!-- FAQ -->
		<Section tone="white">
			<Eyebrow>FAQs</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-huge text-brand-ink">Questions answered.</h2>
			<div class="mt-10 max-w-3xl">
				<FaqAccordion items={faqs} />
			</div>
		</Section>

		<!-- Final CTA -->
		<Section tone="purple">
			<div class="flex flex-col items-center gap-6 text-center">
				<h2 class="text-statement max-w-2xl text-huge text-brand-white">
					Ready to stop guessing and start owning your marketing?
				</h2>
				<PrimaryCTA tone="citrus" ring="citrus" />
			</div>
		</Section>
	</main>
</Layout>
