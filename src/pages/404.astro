---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import PrimaryCTA from "../components/PrimaryCTA.astro";
---

<Layout title="Page Not Found | SumoLab" description="This page doesn't exist.">
	<main>
		<Section tone="offwhite" class="flex min-h-[60vh] items-center pt-14 pb-16 md:pt-20">
			<div>
				<p class="text-label text-brand-purple">404</p>
				<h1 class="text-statement mt-4 max-w-2xl text-mega text-brand-ink">
					This page doesn't exist.
				</h1>
				<p class="text-supporting mt-6 max-w-xl text-brand-neutral">
					The page you're looking for may have moved, or the link may be out of date. Here are a few places
					to go instead.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-4">
					<a
						href="/"
						class="text-button inline-flex items-center gap-2 rounded-sm bg-brand-purple px-5 py-3 text-brand-white transition-colors duration-150 hover:bg-brand-purple-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-purple"
					>
						Back to homepage
					</a>
					<PrimaryCTA tone="citrus" />
				</div>
			</div>
		</Section>
	</main>
</Layout>
