---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PrimaryCTA from "../components/PrimaryCTA.astro";
import { fitFor, notFitFor } from "../data/fit";

const signals = [
	"The owner or CEO is making marketing decisions without marketing expertise",
	"The company relies heavily on referrals and wants predictable lead generation",
	"Marketing tactics exist, but no unified strategy connects them",
	"Marketing responsibilities are spread across several people, with no one in charge",
];
---

<Layout
	title="Who It's For | SumoLab"
	description="SumoLab works with established businesses generating $5M to $50M in annual revenue that need senior marketing leadership, not more isolated campaigns."
>
	<main>
		<section class="relative isolate overflow-hidden">
			<img
				src="/photos/who-its-for-hero.jpg"
				alt="Senior business leader in an established company office"
				width="2752"
				height="1536"
				class="absolute inset-0 h-full w-full object-cover"
			/>
			<div class="absolute inset-0 bg-gradient-to-r from-brand-ink/85 via-brand-ink/60 to-brand-ink/25" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-(--container-content) px-6 py-10 md:px-10 md:py-14 lg:px-12">
				<Eyebrow tone="citrus">Who it's for</Eyebrow>
				<h1 class="text-statement mt-4 max-w-3xl text-mega text-brand-offwhite">
					Built for serious business...
				</h1>
				<p class="text-supporting mt-6 max-w-2xl text-[2rem] font-semibold leading-snug text-brand-offwhite">
					not startups looking for cheap execution.
				</p>
				<p class="text-supporting mt-4 max-w-2xl text-brand-offwhite/85">
					SumoLab works best with companies that have real marketing activity already underway and need someone
					senior to lead it. Here's how to tell if that's you.
				</p>
			</div>
		</section>

		<Section tone="white">
			<Eyebrow>Signals it's time</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-huge text-brand-ink">
				If any of this sounds familiar&hellip;
			</h2>
			<ul class="mt-10 grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
				{
					signals.map((signal) => (
						<li class="flex items-start gap-3">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-purple" aria-hidden="true" />
							<span class="text-supporting text-brand-ink">{signal}</span>
						</li>
					))
				}
			</ul>
		</Section>

		<Section tone="offwhite">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
				<div class="lg:col-span-7">
					<Eyebrow>Strong fit</Eyebrow>
					<h2 class="text-statement mt-4 text-huge text-brand-ink">
						SumoLab may be a strong fit if&hellip;
					</h2>
					<ul class="mt-8 flex flex-col gap-4">
						{
							fitFor.map((item) => (
								<li class="flex items-start gap-3">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-purple" aria-hidden="true" />
									<span class="text-supporting text-brand-ink">{item}</span>
								</li>
							))
						}
					</ul>
				</div>
				<div class="lg:col-span-5 lg:pt-2">
					<p class="text-label text-brand-neutral">Probably not the right fit if</p>
					<ul class="mt-5 flex flex-col gap-4">
						{
							notFitFor.map((item) => (
								<li class="flex items-start gap-3">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-neutral" aria-hidden="true" />
									<span class="text-supporting text-brand-neutral">{item}</span>
								</li>
							))
						}
					</ul>
					<p class="text-supporting mt-6 text-brand-neutral">
						If that's where you are today, that's a completely reasonable place to be. It's just not what
						SumoLab is built for, and we'd rather tell you that upfront.
					</p>
				</div>
			</div>
		</Section>

		<Section tone="purple">
			<div class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
				<h2 class="text-statement max-w-xl text-huge text-brand-white">
					Still not sure? A short conversation will make it clear.
				</h2>
				<PrimaryCTA tone="citrus" ring="citrus" />
			</div>
		</Section>
	</main>
</Layout>
