---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
---

<Layout title="Terms | SumoLab" description="SumoLab's terms of use for this website.">
	<main>
		<Section tone="offwhite" class="pt-14 pb-16 md:pt-20">
			<Eyebrow>Legal</Eyebrow>
			<h1 class="text-statement mt-4 max-w-3xl text-mega text-brand-ink">Terms of Use</h1>
			<p class="text-supporting mt-6 max-w-2xl text-brand-neutral">
				This is a placeholder terms page and has not yet been reviewed by legal counsel. Replace this page
				before launch.
			</p>
		</Section>

		<Section tone="white">
			<div class="flex max-w-3xl flex-col gap-10">
				<div>
					<h2 class="text-statement text-xl text-brand-ink">Use of this site</h2>
					<p class="text-supporting mt-3 text-brand-neutral">
						This website is provided for informational purposes about SumoLab's services. Content on this
						site does not constitute a service agreement or guarantee of results.
					</p>
				</div>
				<div>
					<h2 class="text-statement text-xl text-brand-ink">Engagements</h2>
					<p class="text-supporting mt-3 text-brand-neutral">
						Any consulting or fractional leadership engagement with SumoLab is governed by a separate,
						signed agreement, not by this website.
					</p>
				</div>
				<div>
					<h2 class="text-statement text-xl text-brand-ink">Changes</h2>
					<p class="text-supporting mt-3 text-brand-neutral">
						These terms may be updated from time to time. The current version will always be available at
						this page.
					</p>
				</div>
			</div>
		</Section>
	</main>
</Layout>
