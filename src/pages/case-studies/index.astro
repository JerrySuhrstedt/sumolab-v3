---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import PrimaryCTA from "../../components/PrimaryCTA.astro";
import { caseStudies } from "../../data/case-studies";
---

<Layout
	title="Case Studies | SumoLab"
	description="Real engagements across home building, medical supply, and enterprise mobility — the problem going in, the decision that changed it, and the result it produced."
>
	<main>
		<section class="relative isolate overflow-hidden">
			<img
				src="/photos/case-studies-hero.jpg"
				alt="Three colleagues reviewing a results chart together"
				width="2752"
				height="1536"
				class="absolute inset-0 h-full w-full object-cover object-[80%_center] md:object-center"
			/>
			<div class="absolute inset-0 bg-gradient-to-r from-brand-ink/85 via-brand-ink/60 to-brand-ink/25" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-(--container-content) px-6 py-10 md:px-10 md:py-14 lg:px-12">
				<Eyebrow tone="citrus">Case Studies</Eyebrow>
				<h1 class="text-statement mt-4 max-w-3xl text-mega text-brand-offwhite">Proof, in the numbers.</h1>
				<p class="text-supporting mt-6 max-w-2xl text-[2rem] font-semibold leading-snug text-brand-offwhite">
					Real engagements across home building, medical supply, and enterprise mobility — the problem going
					in, the decision that changed it, and the result it produced.
				</p>
			</div>
		</section>

		<Section tone="white">
			<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
				{
					caseStudies.map((caseStudy) => (
						<a
							href={`/case-studies/${caseStudy.slug}`}
							class="group flex flex-col gap-4 border border-brand-neutral-soft bg-brand-white p-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-purple md:p-10"
						>
							<p class="text-label text-brand-neutral">{caseStudy.client}</p>
							<h2 class="text-statement text-2xl text-brand-ink">{caseStudy.title}</h2>
							<p class="text-supporting text-brand-neutral">{caseStudy.summary}</p>
							<span class="text-button mt-auto inline-flex items-center gap-2 self-start text-brand-purple">
								<span>Read the case study</span>
								<span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">
									&rarr;
								</span>
							</span>
						</a>
					))
				}
			</div>
		</Section>

		<Section tone="purple">
			<div class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
				<h2 class="text-statement max-w-xl text-huge text-brand-white">Want results like these for your business?</h2>
				<PrimaryCTA tone="citrus" ring="citrus" />
			</div>
		</Section>
	</main>
</Layout>
