---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";

const callCovers = [
	"Where your marketing stands today, and where the gaps are",
	"Whether a Fractional Marketing Director or focused consulting fits your situation",
	"What an engagement would actually look like for your business",
	"A straight answer on fit, in either direction",
];
---

<Layout
	title="Book a Strategy Call | SumoLab"
	description="Schedule a strategy call with SumoLab. Tell us about your business and we'll follow up to discuss whether senior marketing leadership is the right fit."
>
	<main>
		<Section tone="offwhite" class="pt-14 pb-16 md:pt-20">
			<Eyebrow>Contact</Eyebrow>
			<h1 class="text-statement mt-4 max-w-3xl text-mega text-brand-ink">Book a strategy call.</h1>
			<p class="text-supporting mt-6 max-w-2xl text-brand-neutral">
				Tell us about your business below. This is a practical conversation about your marketing, not a sales
				pitch, and we'll tell you honestly if SumoLab isn't the right fit.
			</p>
		</Section>

		<Section tone="white">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
				<div class="lg:col-span-7">
					<script is:inline src="https://js-na2.hsforms.net/forms/embed/244692534.js" defer></script>
					<div
						class="hs-form-frame"
						data-region="na2"
						data-form-id="f9445925-a2ec-4b85-82d4-45192a42e60d"
						data-portal-id="244692534"
					>
					</div>
				</div>
				<div class="lg:col-span-5 lg:pt-2">
					<p class="text-label text-brand-neutral">What the call covers</p>
					<ul class="mt-5 flex flex-col gap-4">
						{
							callCovers.map((item) => (
								<li class="flex items-start gap-3">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-purple" aria-hidden="true" />
									<span class="text-supporting text-brand-ink">{item}</span>
								</li>
							))
						}
					</ul>
					<p class="text-supporting mt-8 text-brand-neutral">
						SumoLab is built for established businesses generating $5M+ in annual revenue. If that's not
						quite you yet, we'll say so, and point you in a more useful direction if we can.
					</p>
				</div>
			</div>
		</Section>
	</main>
</Layout>
