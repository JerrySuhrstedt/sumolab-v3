---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import PrimaryCTA from "../../components/PrimaryCTA.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import { services } from "../../data/services";

export function getStaticPaths() {
	return services.map((service) => ({
		params: { slug: service.slug },
		props: { service },
	}));
}

const { service } = Astro.props;

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Service",
	name: service.name,
	description: service.summary,
	provider: {
		"@type": "ProfessionalService",
		name: "SumoLab",
		url: "https://sumolab.co",
	},
	areaServed: "US",
};
---

<Layout title={`${service.name} | SumoLab`} description={service.summary} structuredData={structuredData}>
	<main>
		<Section tone="offwhite" class="pt-14 pb-16 md:pt-20">
			<Eyebrow>Services</Eyebrow>
			<h1 class="text-statement mt-4 max-w-3xl text-5xl text-brand-ink sm:text-6xl lg:text-7xl">{service.name}</h1>
			<p class="text-supporting mt-6 max-w-2xl text-lg text-brand-neutral">{service.tagline}</p>
			<div class="mt-8">
				<PrimaryCTA tone="citrus" />
			</div>
		</Section>

		<Section tone="white">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
				<div class="lg:col-span-5">
					<Eyebrow>The situation</Eyebrow>
					<h2 class="text-statement mt-4 text-2xl text-brand-ink sm:text-3xl">{service.situation}</h2>
				</div>
				<div class="lg:col-span-7 lg:pt-2">
					<p class="text-label text-brand-neutral">Common symptoms</p>
					<ul class="mt-5 flex flex-col gap-4">
						{
							service.symptoms.map((symptom) => (
								<li class="flex items-start gap-3 border-b border-brand-neutral-soft pb-4 last:border-b-0">
									<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-purple" aria-hidden="true" />
									<span class="text-supporting text-brand-ink">{symptom}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</Section>

		<Section tone="offwhite">
			<Eyebrow>What's included</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-4xl text-brand-ink sm:text-5xl">What this engagement covers.</h2>
			<div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2">
				{
					service.includes.map((item) => (
						<div class="border-t-2 border-brand-purple pt-5">
							<h3 class="text-statement text-xl text-brand-ink">{item.title}</h3>
							<p class="text-supporting mt-3 text-brand-neutral">{item.description}</p>
						</div>
					))
				}
			</div>
		</Section>

		<Section tone="white">
			<Eyebrow>How it works</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-4xl text-brand-ink sm:text-5xl">The engagement, step by step.</h2>
			<ol class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
				{
					service.howItWorks.map((step, index) => (
						<li class="border-t-2 border-brand-purple pt-5">
							<span class="text-label text-brand-neutral">{String(index + 1).padStart(2, "0")}</span>
							<p class="text-supporting mt-3 text-brand-ink">{step}</p>
						</li>
					))
				}
			</ol>
		</Section>

		<Section tone="ink">
			<Eyebrow tone="citrus">Outcomes</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-4xl text-brand-offwhite sm:text-5xl">
				What changes for your business.
			</h2>
			<ul class="mt-10 grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
				{
					service.outcomes.map((outcome) => (
						<li class="flex items-start gap-3">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-citrus" aria-hidden="true" />
							<span class="text-supporting text-brand-offwhite/90">{outcome}</span>
						</li>
					))
				}
			</ul>
		</Section>

		<Section tone="offwhite">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
				<div class="lg:col-span-6">
					<Eyebrow>Who it's for</Eyebrow>
					<ul class="mt-5 flex flex-col gap-4">
						{
							service.whoItsFor.map((item) => (
								<li class="flex items-start gap-3">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-purple" aria-hidden="true" />
									<span class="text-supporting text-brand-ink">{item}</span>
								</li>
							))
						}
					</ul>
				</div>
				<div class="lg:col-span-6">
					<p class="text-label text-brand-neutral">Who it's not for</p>
					<ul class="mt-5 flex flex-col gap-4">
						{
							service.whoItsNotFor.map((item) => (
								<li class="flex items-start gap-3">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-neutral" aria-hidden="true" />
									<span class="text-supporting text-brand-neutral">{item}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</Section>

		<Section tone="white">
			<Eyebrow>FAQ</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-4xl text-brand-ink sm:text-5xl">Common questions.</h2>
			<div class="mt-10 max-w-3xl">
				<FaqAccordion items={service.faqs} />
			</div>
		</Section>

		<Section tone="purple">
			<div class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
				<h2 class="text-statement max-w-xl text-2xl text-brand-white sm:text-3xl">
					Let's talk about whether {service.shortName.toLowerCase()} is the right fit.
				</h2>
				<PrimaryCTA tone="citrus" ring="citrus" />
			</div>
		</Section>
	</main>
</Layout>
