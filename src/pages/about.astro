---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PrimaryCTA from "../components/PrimaryCTA.astro";
import { founder } from "../data/founder";
---

<Layout
	title="About | SumoLab"
	description="Most AI advice comes from people who've never had to make payroll. Mine comes from 28 years of building and running businesses, and going deep on AI."
>
	<main>
		<section class="relative isolate overflow-hidden">
			<img
				src="/photos/about-hero.jpg"
				alt="Jerry Suhrstedt, founder of SumoLab"
				width="2752"
				height="1536"
				class="absolute inset-0 h-full w-full object-cover object-[65%_top] md:object-center"
			/>
			<div class="absolute inset-0 bg-gradient-to-r from-brand-ink/85 via-brand-ink/60 to-brand-ink/25" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-(--container-content) px-6 py-10 md:px-10 md:py-14 lg:px-12">
				<Eyebrow tone="citrus">About</Eyebrow>
				<h1 class="text-statement mt-4 max-w-3xl text-mega text-brand-offwhite">
					Marketing that runs. Operations that scale.<br />AI that pays.
				</h1>
				<p class="text-supporting mt-6 max-w-2xl text-[2rem] font-semibold leading-snug text-brand-offwhite">
					Most AI advice comes from people who've never had to make payroll. Mine comes from 28 years of
					building and running businesses &mdash; and going deep on AI.
				</p>
			</div>
		</section>

		<Section tone="white">
			<Eyebrow>What is SumoLab?</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-huge text-brand-ink">A laboratory for business growth.</h2>
			<div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
				<div class="lg:col-span-7">
					<p class="text-supporting text-lg text-brand-ink">
						Most companies do not have a marketing problem. They have a strategy problem. They run ads,
						launch campaigns, redesign websites, and post on social media, but without a clear strategy,
						those activities produce inconsistent results. SumoLab exists to solve that problem.
					</p>
					<p class="text-supporting mt-4 text-lg text-brand-ink">
						Growth starts with strategy: positioning, messaging, market focus, and lead generation systems,
						built before execution. Instead of random activities, companies operate with a structured
						marketing engine that supports sales and drives revenue.
					</p>
				</div>
				<div class="lg:col-span-5">
					<div class="bg-brand-purple p-8 text-brand-white">
						<p class="text-label text-brand-citrus">Definition</p>
						<p class="text-statement mt-3 text-2xl">
							SumoLab, noun: a strategic growth laboratory where marketing, messaging, and systems are
							designed, tested, and refined to produce measurable business growth.
						</p>
					</div>
				</div>
			</div>
		</Section>

		<Section tone="offwhite">
			<Eyebrow>Founder</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-huge text-brand-ink">Who's behind SumoLab.</h2>
			<div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
				<div class="lg:col-span-5">
					<img
						src={founder.headshotSrc ?? undefined}
						alt={founder.name ?? "Founder"}
						width="662"
						height="662"
						class="w-full max-w-sm"
					/>
				</div>
				<div class="lg:col-span-7">
					<p class="text-statement text-xl text-brand-ink">{founder.name}</p>
					<p class="text-supporting mt-1 text-brand-neutral">{founder.title}</p>
					<div class="mt-6 flex max-w-2xl flex-col gap-4">
						{founder.longBio.map((paragraph) => <p class="text-supporting text-brand-neutral">{paragraph}</p>)}
					</div>
					{
						founder.linkedinUrl && (
							<a
								href={founder.linkedinUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="text-button mt-4 inline-flex items-center gap-2 text-brand-purple"
							>
								View LinkedIn profile
							</a>
						)
					}
				</div>
			</div>
		</Section>

		<Section tone="white">
			<Eyebrow>Expertise</Eyebrow>
			<h2 class="text-statement mt-4 max-w-2xl text-huge text-brand-ink">Where he focuses.</h2>
			<div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-4 sm:grid-cols-2">
				{
					founder.expertise.map((item) => (
						<div class="flex items-start gap-3 border-b border-brand-neutral-soft pb-4">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-purple" aria-hidden="true" />
							<span class="text-supporting text-brand-ink">{item}</span>
						</div>
					))
				}
			</div>
			<p class="text-supporting mt-8 text-brand-neutral">
				Industries served: {founder.industries.join(", ")}.
			</p>
		</Section>

		<Section tone="purple">
			<div class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
				<h2 class="text-statement max-w-xl text-huge text-brand-white">
					Ready to talk about your marketing leadership?
				</h2>
				<PrimaryCTA tone="citrus" ring="citrus" />
			</div>
		</Section>
	</main>
</Layout>
