---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PrimaryCTA from "../components/PrimaryCTA.astro";
import { approachPhases } from "../data/approach";
---

<Layout
	title="Approach | SumoLab"
	description="How a SumoLab engagement works: diagnose, focus, lead, and improve. A clear, practical process for building senior marketing leadership into your business."
>
	<main>
		<section class="relative isolate overflow-hidden">
			<img
				src="/photos/approach-hero.jpg"
				alt="Team member laughing during a working session"
				width="1920"
				height="1080"
				class="absolute inset-0 h-full w-full object-cover"
			/>
			<div class="absolute inset-0 bg-gradient-to-l from-brand-ink/85 via-brand-ink/60 to-brand-ink/25" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-(--container-content) px-6 py-10 md:px-10 md:py-14 lg:px-12">
				<div class="ml-auto max-w-3xl text-right">
					<Eyebrow tone="citrus" class="justify-end">Approach</Eyebrow>
					<h1 class="text-statement mt-4 text-mega text-brand-offwhite">
						A clear process, not a black box.
					</h1>
					<p class="text-supporting mt-6 ml-auto max-w-2xl text-brand-offwhite/85">
						What a Fractional Marketing Director actually is, what the role covers, and how it compares to a
						Fractional CMO.
					</p>
				</div>
			</div>
		</section>

		<Section tone="white">
			<div class="flex flex-col divide-y divide-brand-neutral-soft">
				{
					approachPhases.map((phase) => (
						<div class="grid grid-cols-1 gap-6 py-12 first:pt-0 last:pb-0 lg:grid-cols-12 lg:gap-8">
							<div class="lg:col-span-4">
								<span class="text-label text-brand-neutral">{phase.number}</span>
								<h2 class="text-statement mt-2 text-2xl text-brand-ink sm:text-3xl">{phase.title}</h2>
							</div>
							<div class="lg:col-span-8 lg:pt-1">
								<p class="text-supporting text-lg text-brand-neutral">{phase.detail}</p>
							</div>
						</div>
					))
				}
			</div>
		</Section>

		<Section tone="purple">
			<div class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
				<h2 class="text-statement max-w-xl text-huge text-brand-white">
					See how this process would apply to your business.
				</h2>
				<PrimaryCTA tone="citrus" ring="citrus" />
			</div>
		</Section>
	</main>
</Layout>
