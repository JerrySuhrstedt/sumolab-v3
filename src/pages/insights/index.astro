---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import PrimaryCTA from "../../components/PrimaryCTA.astro";
import { insights } from "../../data/insights";

const categories = [
	"AI in Business",
	"Strategy & Leadership",
	"Marketing & Growth",
	"Sales & CRM",
	"Systems & Automation",
	"Case Studies",
];
---

<Layout
	title="Insights | SumoLab"
	description="Notes on strategy, leadership, and technology for established businesses, written by an operator who's actually done the work."
>
	<main>
		<section class="relative isolate overflow-hidden">
			<img
				src="/photos/insights-hero.jpg"
				alt="Two colleagues reviewing results together"
				width="1920"
				height="1080"
				class="absolute inset-0 h-full w-full object-cover object-[80%_center] md:object-center"
			/>
			<div class="absolute inset-0 bg-gradient-to-r from-brand-ink/85 via-brand-ink/60 to-brand-ink/25" aria-hidden="true"></div>
			<div class="relative mx-auto max-w-(--container-content) px-6 py-10 md:px-10 md:py-14 lg:px-12">
				<Eyebrow tone="citrus">Insights</Eyebrow>
				<h1 class="text-statement mt-4 max-w-3xl text-mega text-brand-offwhite">
					Practical thinking on business, growth, and AI.
				</h1>
				<p class="text-supporting mt-6 max-w-2xl text-[2rem] font-semibold leading-snug text-brand-offwhite">
					Notes on strategy, leadership, and technology for established businesses — written by an operator
					who's actually done the work.
				</p>
			</div>
		</section>

		{
			insights.length > 0 && (
				<div class="bg-brand-white">
					<div class="mx-auto max-w-(--container-content) px-6 pt-5 pb-5 md:px-10 lg:px-12">
						<div class="flex flex-wrap gap-3" id="category-filters">
						<button
							type="button"
							data-category="all"
							class="category-filter-btn is-active border border-brand-ink bg-brand-ink px-4 py-2 text-button text-brand-offwhite transition-colors duration-150"
						>
							All
						</button>
						{categories.map((category) => (
							<button
								type="button"
								data-category={category}
								class="category-filter-btn border border-brand-neutral-soft bg-brand-white px-4 py-2 text-button text-brand-ink transition-colors duration-150 hover:border-brand-purple hover:text-brand-purple"
							>
								{category}
							</button>
						))}
						</div>
					</div>
				</div>
			)
		}

		<Section tone="white">
			{
				insights.length > 0 ? (
					<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3" id="insights-grid">
						{insights.map((article) => (
							<a
								href={`/insights/${article.slug}`}
								data-category={article.category}
								class="group flex flex-col border border-brand-neutral-soft bg-brand-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-purple"
							>
								<div class="aspect-[4/3] overflow-hidden bg-brand-neutral-soft">
									<img
										src={article.imageSrc}
										alt=""
										class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
										loading="lazy"
									/>
								</div>
								<div class="flex flex-col gap-3 p-6">
									<p class="text-label text-brand-neutral">{article.category}</p>
									<h2 class="text-statement text-xl text-brand-ink">{article.title}</h2>
									<p class="text-supporting text-brand-neutral">{article.excerpt}</p>
								</div>
							</a>
						))}
					</div>
				) : (
					<div class="max-w-xl">
						<p class="text-supporting text-lg text-brand-neutral">
							Insights are coming soon. In the meantime, if you'd like to talk through a specific
							marketing challenge directly, book a strategy call.
						</p>
						<div class="mt-6">
							<PrimaryCTA tone="citrus" />
						</div>
					</div>
				)
			}
		</Section>
	</main>

	{
		insights.length > 0 && (
			<script>
				function initInsightsFilter() {
					const buttons = document.querySelectorAll<HTMLButtonElement>(".category-filter-btn");
					const cards = document.querySelectorAll<HTMLAnchorElement>("#insights-grid > a");
					if (buttons.length === 0 || cards.length === 0) return;

					const activeClasses = ["border-brand-ink", "bg-brand-ink", "text-brand-offwhite"];
					const inactiveClasses = [
						"border-brand-neutral-soft",
						"bg-brand-white",
						"text-brand-ink",
						"hover:border-brand-purple",
						"hover:text-brand-purple",
					];

					buttons.forEach((button) => {
						button.addEventListener("click", () => {
							const selected = button.dataset.category;

							buttons.forEach((b) => {
								const isActive = b === button;
								b.classList.toggle("is-active", isActive);
								b.classList.remove(...activeClasses, ...inactiveClasses);
								b.classList.add(...(isActive ? activeClasses : inactiveClasses));
							});

							cards.forEach((card) => {
								const matches = selected === "all" || card.dataset.category === selected;
								card.classList.toggle("hidden", !matches);
							});
						});
					});
				}

				initInsightsFilter();
				document.addEventListener("astro:page-load", initInsightsFilter);
			</script>
		)
	}
</Layout>
