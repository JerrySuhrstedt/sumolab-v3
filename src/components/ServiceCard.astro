---
import type { Service } from "../data/services";

interface Props {
	service: Service;
}

const { service } = Astro.props;
---

<article class="flex flex-col gap-6 border border-brand-neutral-soft bg-brand-white p-8 md:p-10">
	<div>
		<h3 class="text-statement text-2xl text-brand-ink md:text-3xl">{service.name}</h3>
		<p class="text-supporting mt-3 text-brand-neutral">{service.summary}</p>
	</div>

	<ul class="flex flex-col gap-3">
		{
			service.includes.slice(0, 3).map((item) => (
				<li class="flex items-start gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-purple" aria-hidden="true" />
					<span class="text-supporting text-brand-ink">{item.title}</span>
				</li>
			))
		}
	</ul>

	<a
		href={`/services/${service.slug}`}
		class="text-button group mt-auto inline-flex items-center gap-2 self-start text-brand-purple focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-purple"
	>
		<span>Explore How We Help</span>
		<span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-0.5"
			>&rarr;</span
		>
	</a>
</article>
