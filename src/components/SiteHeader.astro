---
import BrandLogo from "./BrandLogo.astro";
import DesktopNavigation from "./DesktopNavigation.astro";
import MobileMenuToggle from "./MobileMenuToggle.astro";
import PrimaryCTA from "./PrimaryCTA.astro";

interface Props {
	/** Starts transparent over a hero image, then solidifies once the page scrolls. */
	transparentOnHero?: boolean;
}

const { transparentOnHero = false } = Astro.props;
---

<header
	id="site-header"
	class:list={[
		"top-0 z-50 transition-[background-color,box-shadow] duration-500 ease-out",
		transparentOnHero ? "header-transparent-on-hero fixed inset-x-0 bg-transparent" : "sticky bg-brand-ink",
	]}
>
	<div
		class="mx-auto flex max-w-(--container-content) items-center justify-between gap-4 px-6 py-4 md:px-10 lg:px-12"
	>
		<BrandLogo variant="white" height={30} />
		<DesktopNavigation />
		<div class="flex items-center gap-4">
			<div class="hidden lg:block">
				<PrimaryCTA tone="citrus" ring="citrus" />
			</div>
			<MobileMenuToggle />
		</div>
	</div>
</header>

<style>
	#site-header.is-scrolled {
		box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.5);
	}

	#site-header.header-transparent-on-hero.is-scrolled {
		background-color: var(--color-brand-ink);
	}
</style>

<script>
	function initHeaderScrollState() {
		const header = document.getElementById("site-header");
		if (!header) return;

		const updateState = () => {
			header.classList.toggle("is-scrolled", window.scrollY > 100);
		};

		updateState();
		window.addEventListener("scroll", updateState, { passive: true });
	}

	initHeaderScrollState();
	document.addEventListener("astro:page-load", initHeaderScrollState);
</script>
