---
import { primaryCta } from "../data/navigation";

interface Props {
	class?: string;
	/** "citrus" is the default high-contrast treatment; "purple" for contexts already on a light/citrus surface. */
	tone?: "citrus" | "purple";
	label?: string;
	href?: string;
}

const {
	class: className = "",
	tone = "citrus",
	label = primaryCta.label,
	href = primaryCta.href,
} = Astro.props;

const toneClasses =
	tone === "citrus"
		? "bg-brand-citrus text-brand-ink hover:bg-brand-ink hover:text-brand-citrus"
		: "bg-brand-purple text-brand-white hover:bg-brand-purple-dark";
---

<a
	href={href}
	class={`text-button group inline-flex items-center gap-2 whitespace-nowrap rounded-sm px-5 py-3 transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-purple ${toneClasses} ${className}`}
>
	<span>{label}</span>
	<span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">
		&rarr;
	</span>
</a>
