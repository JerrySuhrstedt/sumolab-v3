<button
	id="mobile-menu-toggle"
	type="button"
	aria-expanded="false"
	aria-controls="mobile-menu-panel"
	aria-label="Open menu"
	class="menu-toggle relative z-50 -mr-2 inline-flex h-11 w-11 items-center justify-center lg:hidden"
>
	<span class="menu-toggle-icon" aria-hidden="true">
		<span></span>
		<span></span>
		<span></span>
	</span>
</button>

<style>
	.menu-toggle-icon {
		display: inline-flex;
		width: 22px;
		height: 16px;
		flex-direction: column;
		justify-content: space-between;
	}

	.menu-toggle-icon span {
		display: block;
		height: 2px;
		width: 100%;
		background-color: var(--color-brand-ink);
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	#mobile-menu-toggle[aria-expanded="true"] .menu-toggle-icon span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	#mobile-menu-toggle[aria-expanded="true"] .menu-toggle-icon span:nth-child(2) {
		opacity: 0;
	}

	#mobile-menu-toggle[aria-expanded="true"] .menu-toggle-icon span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}
</style>
