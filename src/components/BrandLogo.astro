---
interface Props {
	class?: string;
	/** "default" sits directly on the surface; "plate" places the logo on a light card, for use on dark backgrounds. */
	variant?: "default" | "plate";
	height?: number;
}

const { class: className = "", variant = "default", height = 32 } = Astro.props;
const width = Math.round(height * (300 / 44));
---

{
	variant === "plate" ? (
		<a
			href="/"
			aria-label="SumoLab home"
			class={`inline-flex items-center rounded-md bg-brand-offwhite px-4 py-2.5 ${className}`}
		>
			<img src="/sumolab-logo.png" alt="SumoLab" height={height} width={width} class="h-auto w-auto" />
		</a>
	) : (
		<a href="/" aria-label="SumoLab home" class={`inline-flex items-center ${className}`}>
			<img src="/sumolab-logo.png" alt="SumoLab" height={height} width={width} class="h-auto w-auto" />
		</a>
	)
}
