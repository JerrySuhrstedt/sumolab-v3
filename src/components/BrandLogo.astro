---
interface Props {
	class?: string;
	/** "purple-black" for light (offwhite/white) surfaces; "purple-white" or "white" for dark (ink/purple) surfaces. */
	variant?: "purple-black" | "purple-white" | "white";
	height?: number;
}

const { class: className = "", variant = "purple-black", height = 32 } = Astro.props;
const width = Math.round(height * (462.5 / 68));

const srcByVariant = {
	"purple-black": "/logos/sumolab-purple-black.svg",
	"purple-white": "/logos/sumolab-purple-white.svg",
	white: "/logos/sumolab-white.svg",
};
const src = srcByVariant[variant];
---

<a href="/" aria-label="SumoLab home" class={`inline-flex items-center ${className}`}>
	<img src={src} alt="SumoLab" height={height} width={width} />
</a>
