---
import { primaryNav } from "../data/navigation";
import PrimaryCTA from "./PrimaryCTA.astro";
---

<div id="mobile-menu-panel" role="dialog" aria-modal="true" aria-label="Mobile navigation" class="mobile-panel" hidden>
	<nav aria-label="Mobile primary" class="flex flex-1 flex-col justify-center gap-2 px-6">
		<ul class="flex flex-col gap-1">
			{
				primaryNav.map((item) => (
					<li>
						<a
							href={item.href}
							class="text-statement block py-3 text-4xl text-brand-offwhite focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-citrus sm:text-5xl"
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="mt-8">
			<PrimaryCTA class="w-full justify-center sm:w-auto" tone="citrus" ring="citrus" />
		</div>
	</nav>
</div>

<style>
	.mobile-panel {
		position: fixed;
		inset: 0;
		z-index: 40;
		display: flex;
		flex-direction: column;
		background-color: var(--color-brand-ink);
		opacity: 0;
		transform: translateY(-8px);
		transition:
			opacity 0.22s ease,
			transform 0.22s ease;
	}

	.mobile-panel.is-open {
		opacity: 1;
		transform: translateY(0);
	}
</style>

<script>
	function initMobileNav() {
		const toggle = document.getElementById("mobile-menu-toggle");
		const panel = document.getElementById("mobile-menu-panel");
		if (!toggle || !panel) return;

		let lastFocused: HTMLElement | null = null;

		const getFocusable = () =>
			Array.from(panel.querySelectorAll<HTMLElement>("a, button")).filter(
				(el) => el.offsetParent !== null,
			);

		const onKeydown = (e: KeyboardEvent) => {
			if (e.key === "Escape") {
				closeMenu();
				return;
			}
			if (e.key === "Tab") {
				const focusable = getFocusable();
				if (focusable.length === 0) return;
				const first = focusable[0];
				const last = focusable[focusable.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}
		};

		function openMenu() {
			if (!panel || !toggle) return;
			lastFocused = document.activeElement as HTMLElement;
			panel.hidden = false;
			requestAnimationFrame(() => panel.classList.add("is-open"));
			toggle.setAttribute("aria-expanded", "true");
			toggle.setAttribute("aria-label", "Close menu");
			document.documentElement.style.overflow = "hidden";
			document.addEventListener("keydown", onKeydown);
			getFocusable()[0]?.focus();
		}

		function closeMenu() {
			if (!panel || !toggle) return;
			panel.classList.remove("is-open");
			toggle.setAttribute("aria-expanded", "false");
			toggle.setAttribute("aria-label", "Open menu");
			document.documentElement.style.overflow = "";
			document.removeEventListener("keydown", onKeydown);
			const onTransitionEnd = () => {
				panel.hidden = true;
				panel.removeEventListener("transitionend", onTransitionEnd);
			};
			panel.addEventListener("transitionend", onTransitionEnd);
			(lastFocused ?? toggle).focus();
		}

		toggle.addEventListener("click", () => {
			const isOpen = toggle.getAttribute("aria-expanded") === "true";
			if (isOpen) closeMenu();
			else openMenu();
		});

		panel.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

		// Reset state on Astro view transitions / bfcache restores.
		document.addEventListener("astro:before-preparation", () => {
			panel.hidden = true;
			panel.classList.remove("is-open");
			toggle.setAttribute("aria-expanded", "false");
			document.documentElement.style.overflow = "";
		});
	}

	initMobileNav();
	document.addEventListener("astro:page-load", initMobileNav);
</script>
