---
import BrandLogo from "./BrandLogo.astro";
import PrimaryCTA from "./PrimaryCTA.astro";
import { footerNav, legalNav } from "../data/navigation";
import { contact } from "../data/contact";

const year = new Date().getFullYear();
---

<footer class="bg-brand-ink text-brand-offwhite">
	<div class="mx-auto max-w-(--container-content) px-6 py-16 md:px-10 md:py-20 lg:px-12">
		<div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
			<div class="lg:col-span-5">
				<BrandLogo variant="white" height={26} />
				<p class="text-statement mt-6 max-w-sm text-2xl text-brand-offwhite sm:text-3xl">
					Senior marketing leadership for established businesses ready to turn scattered activity into
					focused growth.
				</p>
			</div>

			<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
				<div>
					<h2 class="text-footer-heading text-brand-neutral-soft">Company</h2>
					<ul class="mt-4 flex flex-col gap-3">
						{
							footerNav.company.map((item) => (
								<li>
									<a
										href={item.href}
										class="text-footer-link text-brand-offwhite/90 transition-colors duration-150 hover:text-brand-citrus focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-citrus"
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div>
					<h2 class="text-footer-heading text-brand-neutral-soft">Services</h2>
					<ul class="mt-4 flex flex-col gap-3">
						{
							footerNav.services.map((item) => (
								<li>
									<a
										href={item.href}
										class="text-footer-link text-brand-offwhite/90 transition-colors duration-150 hover:text-brand-citrus focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-citrus"
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div class="col-span-2 sm:col-span-1">
					<h2 class="text-footer-heading text-brand-neutral-soft">Connect</h2>
					<ul class="mt-4 flex flex-col items-start gap-4">
						<li>
							<PrimaryCTA tone="citrus" ring="citrus" />
						</li>
						<li>
							{
								contact.email ? (
									<a
										href={`mailto:${contact.email}`}
										class="text-footer-link text-brand-offwhite/90 transition-colors duration-150 hover:text-brand-citrus focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-citrus"
									>
										{contact.email}
									</a>
								) : (
									<span class="text-footer-link text-brand-offwhite/50">Email</span>
								)
							}
						</li>
						<li>
							{
								contact.linkedinUrl ? (
									<a
										href={contact.linkedinUrl}
										class="text-footer-link text-brand-offwhite/90 transition-colors duration-150 hover:text-brand-citrus focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-citrus"
										target="_blank"
										rel="noopener noreferrer"
									>
										LinkedIn
									</a>
								) : (
									<span class="text-footer-link text-brand-offwhite/50">LinkedIn</span>
								)
							}
						</li>
					</ul>
				</div>
			</div>
		</div>

		<div
			class="mt-14 flex flex-col-reverse items-start gap-4 border-t border-brand-citrus/25 pt-8 sm:flex-row sm:items-center sm:justify-between"
		>
			<p class="text-legal text-brand-offwhite/60">&copy; {year} SumoLab. All rights reserved.</p>
			<ul class="flex items-center gap-6">
				{
					legalNav.map((item) => (
						<li>
							<a
								href={item.href}
								class="text-legal text-brand-offwhite/60 transition-colors duration-150 hover:text-brand-citrus focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-citrus"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</footer>
