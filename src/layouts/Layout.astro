---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileMenuPanel from "../components/MobileMenuPanel.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "SumoLab | Fractional Marketing Leadership",
	description = "SumoLab provides fractional marketing direction and strategic consulting for established businesses ready to create focus, alignment, and accountable growth.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-brand-offwhite text-brand-ink">
		<SiteHeader />
		<MobileMenuPanel />
		<slot />
		<SiteFooter />
	</body>
</html>
